save.image("C:\\Users\\wechs\\OneDrive\\المستندات\\sagol project\\test study\\statistical analysis")
# 1. טעינת הנתונים שיצרנו
data <- read.csv("Final_P600_Analysis.csv")
# 2. חישוב קורלציית פירסון בין ה-Constraint לאמפליטודת ה-P600 שלך
cor_result <- cor.test(data$Norming, data$Pz_Amplitude, method = "pearson")
print(cor_result)
# חילוץ ה-r (הקורלציה) וה-n (מספר התצפיות) של המדגם שלך
my_r <- cor_result$estimate
my_n <- nrow(data) 
# 3. טעינת הפונקציות לשחזור קורלציה מתוך ה-OSF
source("ReplicationFunctionsCorrelation.R")
# 4. הגדרת נתוני המקור (לצורך ההדגמה אלו משתנים שצריך לחלץ מנתוני המקור של Nieuwland)
# כאן תצטרך להזין את ה-r וה-n המדויקים מתוך מאמר המקור עבור אלקטרודה Pz בשמות העצם
orig_r <- 0.15 # הערך המדויק תלוי בחישוב המקורי
orig_n <- 80   
# 5. הרצת מודל ה-Bayes Factor שמשווה את השחזור שלך למקור
BF_results <- CorrelationReplicationBF(orig_r, orig_n, my_r, my_n)
print(BF_results)
